@using System.Globalization
@model Clinic.PL.ViewModels.PatientDetailsVM
@{
    ViewData["Title"] = $"Patient - {Model.FullName}";
    var inv = CultureInfo.InvariantCulture;

    var initials = string.Join("", Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(x => x.Length > 0 ? x[0].ToString().ToUpper() : ""));
    if (string.IsNullOrEmpty(initials)) initials = "P";

    var age = DateTime.Today.Year - Model.DateOfBirth.Year;
    if (Model.DateOfBirth > DateOnly.FromDateTime(DateTime.Today.AddYears(-age))) age--;
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2 small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Patients</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.FullName</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-3">
            <div class="avatar-circle avatar-circle-lg">@initials</div>
            <div>
                <h2 class="h3 fw-bold mb-1">@Model.FullName</h2>
                <div class="text-muted small">Registered Patient #@Model.Id &bull; @Model.Appointments.Count Recorded Visit(s)</div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary d-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-pencil"></i> Edit Profile
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-arrow-left"></i> All Patients
            </a>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Bio Data Card -->
    <div class="col-md-4">
        <div class="card card-clinic shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="h6 mb-0 text-primary fw-bold">
                    <i class="bi bi-person-vcard me-2"></i> Bio Data
                </h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0 g-2">
                    <dt class="col-5 text-muted small">Full Name</dt>
                    <dd class="col-7 fw-semibold text-dark">@Model.FullName</dd>

                    <dt class="col-5 text-muted small">Date of Birth</dt>
                    <dd class="col-7">
                        @Model.DateOfBirth.ToString("dd MMM yyyy", inv)
                        <span class="badge bg-light text-secondary border ms-1">@age yrs</span>
                    </dd>

                    <dt class="col-5 text-muted small">Phone Number</dt>
                    <dd class="col-7">
                        <a href="tel:@Model.PhoneNumber" class="font-monospace text-decoration-none text-primary fw-semibold">
                            <i class="bi bi-telephone-outbound me-1"></i> @Model.PhoneNumber
                        </a>
                    </dd>

                    <dt class="col-5 text-muted small">Clinic Center</dt>
                    <dd class="col-7 text-muted">My Clinic</dd>

                    <dt class="col-5 text-muted small">Total Visits</dt>
                    <dd class="col-7">
                        <span class="badge bg-light text-primary border">@Model.Appointments.Count appointment(s)</span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Appointment History Table Card -->
    <div class="col-md-8">
        <div class="card card-clinic shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="h6 mb-0 text-primary fw-bold">
                    <i class="bi bi-clock-history me-2"></i> Clinical Appointment History
                </h5>
                <span class="badge bg-light text-secondary border">@Model.Appointments.Count record(s)</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-clinic align-middle mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Doctor</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Appointments.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-calendar-x fs-2 d-block mb-1 text-secondary"></i>
                                        <div>No previous appointments found for this patient.</div>
                                    </td>
                                </tr>
                            }
                            @foreach (var a in Model.Appointments)
                            {
                                var badgeClass = a.Status switch
                                {
                                    "Cancelled" => "badge-status-cancelled",
                                    "Completed" => "badge-status-completed",
                                    _ => "badge-status-booked"
                                };

                                <tr>
                                    <td class="text-muted small">@a.Id</td>
                                    <td class="fw-medium text-dark">
                                        <i class="bi bi-person-fill text-primary me-1"></i> @a.DoctorName
                                    </td>
                                    <td class="small text-muted">@a.Date.ToString("dd MMM yyyy", inv)</td>
                                    <td>
                                        <span class="badge bg-light text-dark border font-monospace">
                                            @a.StartTime.ToString("hh:mm tt", inv)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @badgeClass">
                                            <span class="status-dot"></span>
                                            <span>@a.Status</span>
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Appointments" asp-action="Details" asp-route-id="@a.Id"
                                           class="btn-action-icon btn-action-info" data-bs-toggle="tooltip" data-bs-title="View Visit Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
