@using System.Globalization
@model Clinic.PL.ViewModels.AppointmentDetailsVM
@{
    ViewData["Title"] = $"Appointment #{Model.Id} Details";
    var inv = CultureInfo.InvariantCulture;

    var badgeClass = Model.Status switch
    {
        "Cancelled" => "badge-status-cancelled",
        "Completed" => "badge-status-completed",
        _ => "badge-status-booked"
    };

    var initials = string.Join("", Model.PatientFullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(x => x.Length > 0 ? x[0].ToString().ToUpper() : ""));
    if (string.IsNullOrEmpty(initials)) initials = "P";

    var age = DateTime.Today.Year - Model.PatientDateOfBirth.Year;
    if (Model.PatientDateOfBirth > DateOnly.FromDateTime(DateTime.Today.AddYears(-age))) age--;
}

<!-- Breadcrumbs & Header -->
<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2 small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Appointments</a></li>
            <li class="breadcrumb-item active" aria-current="page">Booking #@Model.Id</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-3">
            <div class="avatar-circle avatar-circle-lg">@initials</div>
            <div>
                <h2 class="h4 fw-bold mb-1">@Model.PatientFullName</h2>
                <div class="text-muted small">Appointment Ref: <strong>#@Model.Id</strong> &bull; Visit Duration: 30 minutes</div>
            </div>
        </div>
        <div>
            <span class="badge @badgeClass fs-6 px-3 py-2 shadow-sm">
                <span class="status-dot"></span>
                <span>@Model.Status</span>
            </span>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Visit Timing Ribbon Card -->
    <div class="col-12">
        <div class="card card-clinic shadow-sm">
            <div class="card-body p-4">
                <div class="row g-3 align-items-center text-center text-md-start">
                    <div class="col-md-4">
                        <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-3">
                            <div class="kpi-card-icon" style="background-color: var(--clinic-primary-light); color: var(--clinic-primary);">
                                <i class="bi bi-calendar3-event"></i>
                            </div>
                            <div>
                                <div class="text-muted small text-uppercase fw-bold">Appointment Date</div>
                                <div class="h5 fw-bold mb-0 text-dark">@Model.Date.ToString("dddd, dd MMM yyyy", inv)</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-3">
                            <div class="kpi-card-icon" style="background-color: var(--clinic-secondary-light); color: var(--clinic-secondary);">
                                <i class="bi bi-clock-history"></i>
                            </div>
                            <div>
                                <div class="text-muted small text-uppercase fw-bold">Visit Time Slot</div>
                                <div class="h5 fw-bold mb-0 text-primary font-monospace">
                                    @Model.StartTime.ToString("hh:mm tt", inv) - @Model.EndTime.ToString("hh:mm tt", inv)
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 text-center text-md-end">
                        <span class="badge bg-light text-secondary border px-3 py-2 font-monospace fs-6">
                            <i class="bi bi-stopwatch me-1 text-primary"></i> 30 Min Session
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Patient Bio Card -->
    <div class="col-md-6">
        <div class="card card-clinic shadow-sm h-100">
            <div class="card-header bg-white d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-vcard text-primary fs-5"></i>
                    <span class="h6 mb-0 fw-bold">Patient Bio Data</span>
                </div>
                <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-person-lines-fill me-1"></i> Patient File
                </a>
            </div>
            <div class="card-body">
                <dl class="row mb-0 g-2">
                    <dt class="col-sm-4 text-muted small">Full Name</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.PatientFullName</dd>

                    <dt class="col-sm-4 text-muted small">Egyptian Phone</dt>
                    <dd class="col-sm-8">
                        <a href="tel:@Model.PatientPhoneNumber" class="text-decoration-none font-monospace fw-semibold text-primary">
                            <i class="bi bi-telephone-outbound me-1"></i> @Model.PatientPhoneNumber
                        </a>
                    </dd>

                    <dt class="col-sm-4 text-muted small">Date of Birth</dt>
                    <dd class="col-sm-8">
                        @Model.PatientDateOfBirth.ToString("dd MMM yyyy", inv)
                        <span class="badge bg-light text-secondary border ms-1">@age years old</span>
                    </dd>

                    <dt class="col-sm-4 text-muted small">Patient ID</dt>
                    <dd class="col-sm-8 text-muted">#@Model.PatientId</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Doctor Details Card -->
    <div class="col-md-6">
        <div class="card card-clinic shadow-sm h-100">
            <div class="card-header bg-white d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-badge text-primary fs-5"></i>
                    <span class="h6 mb-0 fw-bold">Attending Doctor</span>
                </div>
                <a asp-controller="Doctors" asp-action="Details" asp-route-id="@Model.DoctorId" class="btn btn-sm btn-outline-info">
                    <i class="bi bi-calendar-week me-1"></i> Doctor Shifts
                </a>
            </div>
            <div class="card-body">
                <dl class="row mb-0 g-2">
                    <dt class="col-sm-4 text-muted small">Doctor Name</dt>
                    <dd class="col-sm-8 fw-semibold text-dark">@Model.DoctorName</dd>

                    <dt class="col-sm-4 text-muted small">Specialty</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-light text-dark border">
                            <i class="bi bi-award me-1 text-primary"></i>
                            @(string.IsNullOrWhiteSpace(Model.DoctorSpecialty) ? "General Practice" : Model.DoctorSpecialty)
                        </span>
                    </dd>

                    <dt class="col-sm-4 text-muted small">Clinic Center</dt>
                    <dd class="col-sm-8 text-muted">
                        <i class="bi bi-hospital me-1 text-secondary"></i> My Clinic (Main Branch)
                    </dd>

                    <dt class="col-sm-4 text-muted small">Doctor ID</dt>
                    <dd class="col-sm-8 text-muted">#@Model.DoctorId</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Actions Bar -->
    <div class="col-12">
        <div class="card card-clinic shadow-sm">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                </a>

                @if (Model.Status == "Booked")
                {
                    <div class="d-flex gap-2">
                        <form asp-action="Complete" method="post"
                              data-confirm="true"
                              data-confirm-title="Complete Appointment"
                              data-confirm-message="Are you sure you want to mark this appointment for @Model.PatientFullName as Completed?"
                              data-confirm-btn-class="btn-primary"
                              data-confirm-btn-text="Complete Visit">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-success fw-semibold shadow-sm">
                                <i class="bi bi-check-circle-fill me-1"></i> Mark as Completed
                            </button>
                        </form>

                        <form asp-action="Cancel" method="post"
                              data-confirm="true"
                              data-confirm-title="Cancel Appointment"
                              data-confirm-message="Are you sure you want to cancel this appointment? The 30-minute slot will immediately become free."
                              data-confirm-btn-class="btn-danger"
                              data-confirm-btn-text="Cancel Appointment">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-outline-danger fw-semibold shadow-sm">
                                <i class="bi bi-x-circle me-1"></i> Cancel Appointment
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
