@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Clinic System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-clinic sticky-top">
            <div class="container">
                <a class="clinic-brand-logo" asp-controller="Appointments" asp-action="Index">
                    <div class="clinic-logo-icon">
                        <i class="bi bi-hospital"></i>
                    </div>
                    <span>Clinic<span class="text-primary">System</span></span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#clinicNavbar" aria-controls="clinicNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="clinicNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link clinic-nav-link @(currentController == "Appointments" ? "active" : "")"
                               asp-controller="Appointments" asp-action="Index">
                                <i class="bi bi-calendar-check"></i>
                                <span>Appointments</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link clinic-nav-link @(currentController == "Patients" ? "active" : "")"
                               asp-controller="Patients" asp-action="Index">
                                <i class="bi bi-people"></i>
                                <span>Patients</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link clinic-nav-link @(currentController == "Doctors" ? "active" : "")"
                               asp-controller="Doctors" asp-action="Index">
                                <i class="bi bi-person-badge"></i>
                                <span>Doctors & Shifts</span>
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <div class="clinic-live-badge">
                            <span class="status-dot bg-success" style="box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.25);"></span>
                            <span class="text-muted small">Cairo:</span>
                            <span id="clinicLiveClock" class="font-monospace fw-bold text-dark">--:--:--</span>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Toast Notifications -->
    <div class="toast-container toast-container-clinic">
        @if (TempData["Success"] is string successMsg)
        {
            <div class="toast toast-clinic align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill fs-5 text-white"></i>
                        <div class="fw-medium">@successMsg</div>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] is string errorMsg)
        {
            <div class="toast toast-clinic align-items-center text-bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill fs-5 text-white"></i>
                        <div class="fw-medium">@errorMsg</div>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>

    <!-- Reusable Confirmation Modal -->
    <partial name="_ConfirmModalPartial" />

    <main role="main" class="container py-4">
        @RenderBody()
    </main>

    <footer class="footer-clinic mt-auto">
        <div class="container text-center">
            <span>&copy; @DateTime.Today.Year <strong>Clinic Appointment System</strong> &bull; Medical Care & Practice Management</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
