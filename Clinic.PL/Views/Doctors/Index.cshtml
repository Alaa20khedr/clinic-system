@model List<Clinic.PL.ViewModels.DoctorListItemVM>
@{
    ViewData["Title"] = "Doctors Directory";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h2 class="h3 fw-bold mb-1 text-dark">Doctors Directory</h2>
        <p class="text-muted small mb-0">Manage clinic physicians, specialties, and weekly working shifts</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm fw-semibold">
            <i class="bi bi-person-badge-fill"></i>
            <span>Add Doctor</span>
        </a>
    </div>
</div>

<div class="card card-clinic shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-clinic align-middle">
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Doctor Name</th>
                        <th>Specialty</th>
                        <th>Weekly Shifts</th>
                        <th>Total Appointments</th>
                        <th class="text-end" style="min-width: 160px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <div class="avatar-circle mx-auto mb-3" style="width: 56px; height: 56px; background-color: #f1f5f9; color: #94a3b8;">
                                    <i class="bi bi-person-x fs-3"></i>
                                </div>
                                <div class="fw-semibold text-dark">No doctors registered yet.</div>
                            </td>
                        </tr>
                    }
                    @foreach (var d in Model)
                    {
                        var initials = string.Join("", d.Name.Replace("Dr.", "").Split(' ', StringSplitOptions.RemoveEmptyEntries)
                            .Take(2)
                            .Select(x => x.Length > 0 ? x[0].ToString().ToUpper() : ""));
                        if (string.IsNullOrEmpty(initials)) initials = "DR";

                        <tr>
                            <td class="text-muted small">@d.Id</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar-circle" style="background: linear-gradient(135deg, #dcfce7, #bbf7d0); color: #16a34a; border-color: #86efac;">
                                        @initials
                                    </div>
                                    <div>
                                        <a asp-action="Details" asp-route-id="@d.Id" class="text-decoration-none fw-semibold text-dark d-block">
                                            @d.Name
                                        </a>
                                        <span class="text-muted small">ID: #@d.Id</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(d.Specialty))
                                {
                                    <span class="text-muted fst-italic">General Practice</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-award me-1 text-primary"></i> @d.Specialty
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border">
                                    <i class="bi bi-calendar-week me-1"></i> @d.ScheduleCount shift(s)
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-light text-primary border">
                                    <i class="bi bi-calendar-check me-1"></i> @d.AppointmentCount visit(s)
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 shadow-sm"
                                       title="Manage Weekly Shifts">
                                        <i class="bi bi-calendar-week"></i> Schedule
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@d.Id" class="btn-action-icon btn-action-info"
                                       data-bs-toggle="tooltip" data-bs-title="Edit Doctor">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <form asp-action="Delete" method="post" class="d-inline"
                                          data-confirm="true"
                                          data-confirm-title="Delete Doctor"
                                          data-confirm-message="Are you sure you want to delete @d.Name? Deletion is blocked if this doctor has appointments. If no appointments exist, schedules will be deleted first."
                                          data-confirm-btn-class="btn-danger"
                                          data-confirm-btn-text="Delete Doctor">
                                        <input type="hidden" name="id" value="@d.Id" />
                                        <button type="submit" class="btn-action-icon btn-action-danger"
                                                data-bs-toggle="tooltip" data-bs-title="Delete Doctor">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
